---
import Layout from '../layouts/Layout.astro';
import CocktailCard from '../components/CocktailCard.astro';
import cocktailCategories from '../data/cocktails.json';
---

<Layout title="Vibrant Cocktails - Home">
  <header class="mb-12 pt-8 text-center sm:mb-16 sm:pt-12">
    <div class="mb-4 inline-flex items-center rounded-full bg-amber-100 px-4 py-2 text-sm font-semibold text-amber-700 shadow-sm">
      Vibrant Cocktails
    </div>

    <h1 class="text-4xl font-bold tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
      Find your perfect
      <span class="text-amber-500"> cocktail.</span>
    </h1>

    <p class="mx-auto mt-5 max-w-2xl text-base leading-7 text-slate-600 sm:text-lg">
      Explore classic cocktails organized by their base liquor, from creamy
      favorites to timeless spirit-forward classics.
    </p>
  </header>

  <div class="space-y-16 pb-12 sm:space-y-20">
    {
      cocktailCategories.map((category) => (
        <section
          aria-labelledby={`${category.category.toLowerCase().replaceAll(' ', '-')}-heading`}
        >
          <div class="mb-6 flex items-end justify-between gap-4">
            <div>
              <p class="mb-1 text-sm font-semibold uppercase tracking-wider text-amber-600">
                Base Liquor
              </p>

              <h2
                id={`${category.category.toLowerCase().replaceAll(' ', '-')}-heading`}
                class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl"
              >
                {category.category}
              </h2>
            </div>

            <span class="hidden rounded-full bg-slate-100 px-3 py-1 text-sm font-medium text-slate-600 sm:inline-flex">
              {category.cocktails.length} cocktails
            </span>
          </div>

          <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            {
              category.cocktails.map((cocktail) => (
                <CocktailCard cocktail={cocktail} />
              ))
            }
          </div>
        </section>
      ))
    }
  </div>
</Layout>