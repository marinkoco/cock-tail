---
interface Cocktail {
  name: string;
  description: string;
  thumbnailUrl?: string;
  heroUrl?: string;
  ingredients: string[];
  instructions: string[];
  isUnderConstruction: boolean;
}

interface Props {
  cocktail: Cocktail;
}

const { cocktail } = Astro.props;
---

<article
  class:list={[
    'group overflow-hidden rounded-xl border border-slate-200 bg-white shadow-lg transition duration-300',
    !cocktail.isUnderConstruction && 'hover:-translate-y-1 hover:shadow-xl'
  ]}
>
  {
    cocktail.isUnderConstruction ? (
      <div
        class="relative block w-full cursor-not-allowed text-left"
        aria-label={`${cocktail.name} is coming soon`}
        aria-disabled="true"
      >
        <div class="relative aspect-[4/3] overflow-hidden bg-gradient-to-br from-amber-100 via-orange-50 to-amber-200">
          {cocktail.thumbnailUrl ? (
            <img
              src={cocktail.thumbnailUrl}
              alt={cocktail.name}
              class="h-full w-full object-cover grayscale opacity-75"
              loading="lazy"
            />
          ) : (
            <div class="flex h-full w-full items-center justify-center">
              <span class="text-sm font-semibold text-amber-600">
                Cocktail
              </span>
            </div>
          )}

          <div class="absolute inset-0 flex items-center justify-center bg-slate-950/10">
            <span class="rounded-full bg-slate-900/85 px-4 py-2 text-sm font-bold text-white shadow-lg backdrop-blur-sm">
              Coming Soon
            </span>
          </div>
        </div>

        <div class="p-5">
          <h3 class="text-lg font-bold text-slate-700">
            {cocktail.name}
          </h3>

          <p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-500">
            {cocktail.description}
          </p>

          <div class="mt-4 flex items-center justify-between">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">
              Recipe in progress
            </span>

            <span class="text-xs font-medium text-slate-400">
              Locked
            </span>
          </div>
        </div>
      </div>
    ) : (
      <>
        <button
          type="button"
          class="block w-full text-left focus:outline-none focus-visible:ring-4 focus-visible:ring-amber-300"
          data-cocktail-trigger
          aria-label={`View ${cocktail.name} recipe`}
        >
          <div class="relative aspect-[4/3] overflow-hidden bg-gradient-to-br from-amber-100 via-orange-50 to-amber-200">
            {cocktail.thumbnailUrl ? (
              <img
                src={cocktail.thumbnailUrl}
                alt={cocktail.name}
                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                loading="lazy"
              />
            ) : (
              <div class="flex h-full w-full items-center justify-center">
                <span class="text-sm font-semibold text-amber-600">
                  Cocktail
                </span>
              </div>
            )}
          </div>

          <div class="p-5">
            <h3 class="text-lg font-bold text-slate-900 transition-colors group-hover:text-amber-600">
              {cocktail.name}
            </h3>

            <p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-600">
              {cocktail.description}
            </p>

            <div class="mt-4 text-sm font-semibold text-amber-600">
              View recipe →
            </div>
          </div>
        </button>

        <dialog
          class="fixed inset-0 m-auto w-[calc(100%-2rem)] max-w-5xl overflow-hidden rounded-2xl border-0 bg-white p-0 shadow-2xl backdrop:bg-slate-950/70 backdrop:backdrop-blur-sm"
          data-cocktail-dialog
        >
          <div class="max-h-[90vh] overflow-y-auto">
            <div class="grid md:grid-cols-2">
              <div class="relative min-h-64 bg-gradient-to-br from-amber-100 via-orange-50 to-amber-200 md:min-h-full">
                {cocktail.heroUrl ? (
                  <img
                    src={cocktail.heroUrl}
                    alt={cocktail.name}
                    class="h-full max-h-[420px] w-full object-cover md:sticky md:top-0 md:h-full md:max-h-none"
                  />
                ) : (
                  <div class="flex min-h-64 items-center justify-center">
                    <span class="text-lg font-semibold text-amber-600">
                      Cocktail
                    </span>
                  </div>
                )}
              </div>

              <div class="relative p-6 sm:p-8">
                <button
                  type="button"
                  data-cocktail-close
                  class="absolute right-4 top-4 inline-flex h-10 w-10 items-center justify-center rounded-full bg-slate-100 text-xl font-semibold text-slate-600 transition hover:bg-amber-100 hover:text-amber-700 focus:outline-none focus-visible:ring-4 focus-visible:ring-amber-300"
                  aria-label={`Close ${cocktail.name} recipe`}
                >
                  <span aria-hidden="true">&times;</span>
                </button>

                <div class="pr-12">
                  <p class="text-sm font-semibold uppercase tracking-wider text-amber-600">
                    Cocktail Recipe
                  </p>

                  <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
                    {cocktail.name}
                  </h2>

                  <p class="mt-3 text-base leading-7 text-slate-600">
                    {cocktail.description}
                  </p>
                </div>

                <div class="mt-8 space-y-8">
                  <section>
                    <h3 class="text-xl font-bold text-slate-900">
                      Ingredients
                    </h3>

                    <ul class="mt-4 space-y-3">
                      {cocktail.ingredients.map((ingredient) => (
                        <li class="flex gap-3 text-sm leading-6 text-slate-700">
                          <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-amber-500" />
                          <span>{ingredient}</span>
                        </li>
                      ))}
                    </ul>
                  </section>

                  <section>
                    <h3 class="text-xl font-bold text-slate-900">
                      Instructions
                    </h3>

                    <ol class="mt-4 space-y-4">
                      {cocktail.instructions.map((instruction, index) => (
                        <li class="flex gap-4 text-sm leading-6 text-slate-700">
                          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-amber-100 text-xs font-bold text-amber-700">
                            {index + 1}
                          </span>
                          <span class="pt-0.5">{instruction}</span>
                        </li>
                      ))}
                    </ol>
                  </section>
                </div>
              </div>
            </div>
          </div>
        </dialog>
      </>
    )
  }
</article>

<script>
  function setupCocktailModals() {
    const triggers = document.querySelectorAll<HTMLElement>('[data-cocktail-trigger]');

    triggers.forEach((trigger) => {
      if (trigger.dataset.initialized === 'true') return;
      trigger.dataset.initialized = 'true';

      const card = trigger.closest('article');
      const dialog = card?.querySelector<HTMLDialogElement>('[data-cocktail-dialog]');
      const closeButton = dialog?.querySelector<HTMLButtonElement>('[data-cocktail-close]');

      if (!dialog || !closeButton) return;

      trigger.addEventListener('click', () => dialog.showModal());
      closeButton.addEventListener('click', () => dialog.close());

      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });

      dialog.addEventListener('close', () => trigger.focus());
    });
  }

  setupCocktailModals();
  document.addEventListener('astro:page-load', setupCocktailModals);
</script>