---
interface Cocktail {
  name: string;
  description: string;
  thumbnailUrl?: string;
  heroUrl?: string;
  ingredients: string[];
  instructions: string[];
  isUnderConstruction: boolean;
}

interface Props {
  cocktail: Cocktail;
}

const { cocktail } = Astro.props;

// Get base URL (e.g. '/cock-tail/') and normalize trailing/leading slashes
const rawBase = import.meta.env.BASE_URL || '/';
const baseUrl = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;

const resolveImageUrl = (url?: string) => {
  if (!url) return undefined;
  if (url.startsWith('http://') || url.startsWith('https://')) return url;
  const cleanPath = url.startsWith('/') ? url : `/${url}`;
  return `${baseUrl}${cleanPath}`;
};

const thumbnailUrl = resolveImageUrl(cocktail.thumbnailUrl);
const heroUrl = resolveImageUrl(cocktail.heroUrl);
---

<article
  class:list={[
    'group overflow-hidden rounded-xl border border-slate-200 bg-white shadow-lg transition duration-300',
    !cocktail.isUnderConstruction && 'hover:-translate-y-1 hover:shadow-xl'
  ]}
>
  {
    cocktail.isUnderConstruction ? (
      <div
        class="relative block w-full cursor-not-allowed text-left"
        aria-label={`${cocktail.name} is coming soon`}
        aria-disabled="true"
      >
        <div class="relative aspect-[4/3] overflow-hidden bg-slate-100">
          {thumbnailUrl ? (
            <img
              src={thumbnailUrl}
              alt={cocktail.name}
              class="h-full w-full object-cover grayscale opacity-60"
              loading="lazy"
            />
          ) : (
            <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-amber-100 via-orange-50 to-amber-200">
              <span class="text-sm font-semibold text-amber-700">
                {cocktail.name}
              </span>
            </div>
          )}

          <div class="absolute inset-0 flex items-center justify-center bg-slate-950/20">
            <span class="rounded-full bg-slate-900/85 px-4 py-2 text-sm font-bold text-white shadow-lg backdrop-blur-sm">
              Coming Soon
            </span>
          </div>
        </div>

        <div class="p-5">
          <h3 class="text-lg font-bold text-slate-700">
            {cocktail.name}
          </h3>

          <p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-500">
            {cocktail.description}
          </p>

          <div class="mt-4 flex items-center justify-between">
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">
              Recipe in progress
            </span>

            <span class="text-xs font-medium text-slate-400">
              Locked
            </span>
          </div>
        </div>
      </div>
    ) : (
      <>
        <button
          type="button"
          class="block w-full text-left focus:outline-none focus-visible:ring-4 focus-visible:ring-amber-300"
          data-cocktail-trigger
          aria-label={`View ${cocktail.name} recipe`}
        >
          <div class="relative aspect-[4/3] overflow-hidden bg-slate-100">
            {thumbnailUrl ? (
              <img
                src={thumbnailUrl}
                alt={cocktail.name}
                class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                loading="lazy"
              />
            ) : (
              <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-amber-100 via-orange-50 to-amber-200">
                <span class="text-sm font-semibold text-amber-700">
                  {cocktail.name}
                </span>
              </div>
            )}
          </div>

          <div class="p-5">
            <h3 class="text-lg font-bold text-slate-900 transition-colors group-hover:text-amber-600">
              {cocktail.name}
            </h3>

            <p class="mt-2 line-clamp-2 text-sm leading-6 text-slate-600">
              {cocktail.description}
            </p>

            <div class="mt-4 text-sm font-semibold text-amber-600">
              View recipe →
            </div>
          </div>
        </button>

        <dialog
          class="fixed inset-0 m-auto w-[calc(100%-2rem)] max-w-4xl overflow-hidden rounded-2xl border-0 bg-white p-0 shadow-2xl backdrop:bg-slate-950/70 backdrop:backdrop-blur-sm"
          data-cocktail-dialog
        >
          <div class="max-h-[85vh] overflow-y-auto">
            {/* Mobile: Flex Column (Image top, recipe bottom) | Desktop: Grid 2 Columns */}
            <div class="flex flex-col md:grid md:grid-cols-2">
              
              {/* Image Container */}
              <div class="relative h-64 w-full bg-slate-100 md:h-full md:min-h-[450px]">
                {heroUrl ? (
                  <img
                    src={heroUrl}
                    alt={cocktail.name}
                    class="h-full w-full object-cover"
                  />
                ) : (
                  <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-amber-100 via-orange-50 to-amber-200 p-6 text-center">
                    <span class="text-xl font-bold text-amber-800">
                      {cocktail.name}
                    </span>
                  </div>
                )}
              </div>

              {/* Recipe Info Container */}
              <div class="relative p-6 sm:p-8">
                <button
                  type="button"
                  data-cocktail-close
                  class="absolute right-4 top-4 z-10 inline-flex h-9 w-9 items-center justify-center rounded-full bg-slate-100 text-slate-600 transition hover:bg-amber-100 hover:text-amber-700 focus:outline-none"
                  aria-label={`Close ${cocktail.name} recipe`}
                >
                  <span class="text-xl font-bold">&times;</span>
                </button>

                <div class="pr-8">
                  <p class="text-xs font-semibold uppercase tracking-wider text-amber-600">
                    Cocktail Recipe
                  </p>

                  <h2 class="mt-1 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
                    {cocktail.name}
                  </h2>

                  <p class="mt-2 text-sm leading-6 text-slate-600">
                    {cocktail.description}
                  </p>
                </div>

                <div class="mt-6 space-y-6">
                  <section>
                    <h3 class="text-base font-bold text-slate-900">
                      Ingredients
                    </h3>

                    <ul class="mt-3 space-y-2">
                      {cocktail.ingredients.map((ingredient) => (
                        <li class="flex items-center gap-2.5 text-sm text-slate-700">
                          <span class="h-1.5 w-1.5 shrink-0 rounded-full bg-amber-500" />
                          <span>{ingredient}</span>
                        </li>
                      ))}
                    </ul>
                  </section>

                  <section>
                    <h3 class="text-base font-bold text-slate-900">
                      Instructions
                    </h3>

                    <ol class="mt-3 space-y-3">
                      {cocktail.instructions.map((instruction, index) => (
                        <li class="flex gap-3 text-sm text-slate-700">
                          <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-amber-100 text-xs font-bold text-amber-800">
                            {index + 1}
                          </span>
                          <span class="pt-0.5">{instruction}</span>
                        </li>
                      ))}
                    </ol>
                  </section>
                </div>
              </div>

            </div>
          </div>
        </dialog>
      </>
    )
  }
</article>

<script>
  function setupCocktailModals() {
    const triggers = document.querySelectorAll<HTMLElement>('[data-cocktail-trigger]');

    triggers.forEach((trigger) => {
      if (trigger.dataset.initialized === 'true') return;
      trigger.dataset.initialized = 'true';

      const card = trigger.closest('article');
      const dialog = card?.querySelector<HTMLDialogElement>('[data-cocktail-dialog]');
      const closeButton = dialog?.querySelector<HTMLButtonElement>('[data-cocktail-close]');

      if (!dialog || !closeButton) return;

      trigger.addEventListener('click', () => dialog.showModal());
      closeButton.addEventListener('click', () => dialog.close());

      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });

      dialog.addEventListener('close', () => trigger.focus());
    });
  }

  setupCocktailModals();
  document.addEventListener('astro:page-load', setupCocktailModals);
</script>